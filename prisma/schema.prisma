generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────

enum EscrowState {
  CREATED
  FUNDED
  ACTIVE
  COMPLETED
  DISPUTED
  REFUNDED
}

enum EscrowMode {
  LOCKED
  ARBITER
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
  ARBITER
}

enum TransactionType {
  FUND
  RELEASE
  REFUND
  DISPUTE_RESOLUTION
  FEE_COLLECTION
  DEPOSIT_WALLET
  WITHDRAWAL
  ADMIN_RELEASE
}

enum FundingMethod {
  WALLET_DIRECT
  DEPOSIT_TRANSFER
}

enum TokenStatus {
  ACTIVE
  BLACKLISTED
  FEATURED
}

enum Dispoutcome {
  PENDING
  BUYER_FAVORED
  SELLER_FAVORED
  SPLIT
}

enum ChainNetwork {
  ETHEREUM
  BNB_CHAIN
  POLYGON
  ARBITRUM
  BASE
  AVALANCHE
  OPTIMISM
  FANTOM
}

// ─── MODELS ─────────────────────────────────────

model User {
  id              String   @id @default(cuid())
  walletAddress   String   @unique
  displayName     String?
  email           String?  @unique
  role            UserRole @default(BUYER)
  isAdmin         Boolean  @default(false)
  isArbiter       Boolean  @default(false)
  isFrozen        Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  buyerEscrows      Escrow[]    @relation("BuyerEscrows")
  sellerEscrows     Escrow[]    @relation("SellerEscrows")
  arbiterEscrows    Escrow[]    @relation("ArbiterEscrows")
  dispuInits        Dispute[]   @relation("DisputeInitiator")
  dispuResolvs      Dispute[]   @relation("DisputeResolver")
  wallets           UserWallet[]
  chatRooms           ChatRoom[]
  chatMessages      ChatMessage[]
  adminTransfers    AdminTransfer[]

  @@index([walletAddress])
}

model UserWallet {
  id            String        @id @default(cuid())
  user          User          @relation(fields: [userId], references: [id])
  userId        String
  address       String
  network       ChainNetwork
  label         String?
  isPreferred   Boolean       @default(false)
  isVerified    Boolean       @default(false)
  balance       String?
  lastChecked   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([userId, address, network])
  @@index([userId])
  @@index([network])
}

model Token {
  id              String      @id @default(cuid())
  address         String      @unique
  chainId         Int
  network         ChainNetwork @default(ETHEREUM)
  symbol          String
  name            String
  decimals        Int         @default(18)
  logoUrl         String?
  status          TokenStatus @default(ACTIVE)
  isReflective    Boolean     @default(false)
  hasTax          Boolean     @default(false)
  taxBasisPoints  Int?
  coinGeckoId     String?
  addedBy         String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  escrows         Escrow[]

  @@unique([address, chainId])
  @@index([status])
  @@index([chainId])
}

model Escrow {
  id                      String       @id @default(cuid())
  onChainId               Int          @unique
  chainId                 Int
  network                 ChainNetwork @default(ETHEREUM)
  title                   String
  description             String?
  buyer                   User         @relation("BuyerEscrows", fields: [buyerId], references: [id])
  buyerId                 String
  seller                  User         @relation("SellerEscrows", fields: [sellerId], references: [id])
  sellerId                String
  arbiter                 User?        @relation("ArbiterEscrows", fields: [arbiterId], references: [id])
  arbiterId               String?
  token                   Token        @relation(fields: [tokenId], references: [id])
  tokenId                 String
  totalAmount             String
  fundedAmount            String
  releasedAmount          String       @default("0")
  protocolFeeTotal        String       @default("0")
  state                   EscrowState  @default(CREATED)
  mode                    EscrowMode   @default(LOCKED)
  fundingMethod           FundingMethod?
  agreementHash           String?
  agreementText           String?
  deadline                DateTime?
  fundedAt                DateTime?
  completedAt             DateTime?
  adminApproved           Boolean      @default(false)
  adminApprovedBy         String?
  adminApprovedAt         DateTime?
  adminNotes              String?
  depositWalletAddr       String?
  depositWalletKey        String?
  depositConfirmed        Boolean      @default(false)
  derivationIndex         Int?
  depositNetwork          String?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  milestones              Milestone[]
  transactions            Transaction[]
  dispuInits              Dispute[]     @relation("DisputeEscrow")
  chainEvents             ChainEvent[]
  depositAddress      DepositAddress?
  chatRooms               ChatRoom[]

  @@index([state])
  @@index([buyerId])
  @@index([sellerId])
  @@index([chainId])
  @@index([network])
}

model Milestone {
  id                    String    @id @default(cuid())
  escrow                Escrow    @relation(fields: [escrowId], references: [id], onDelete: Cascade)
  escrowId              String
  index                 Int
  description           String
  amount                String
  released              Boolean   @default(false)
  dispensed             Boolean   @default(false)
  buyerApproved         Boolean   @default(false)
  sellerDelivered       Boolean   @default(false)
  adminApproved         Boolean   @default(false)
  releasedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  dispuInits            Dispute[]

  @@unique([escrowId, index])
  @@index([escrowId])
}

model Transaction {
  id                String          @id @default(cuid())
  escrow            Escrow          @relation(fields: [escrowId], references: [id], onDelete: Cascade)
  escrowId          String
  txHash            String          @unique
  type              TransactionType
  fromAddress       String
  toAddress         String
  amount            String
  feeAmount         String?
  chainId           Int
  blockNumber       Int?
  status            String          @default("CONFIRMED")
  createdAt         DateTime        @default(now())

  @@index([escrowId])
  @@index([txHash])
  @@index([type])
}

model Dispute {
  id              String      @id @default(cuid())
  escrow          Escrow      @relation("DisputeEscrow", fields: [escrowId], references: [id])
  escrowId        String
  milestone       Milestone?  @relation(fields: [milestoneId], references: [id])
  milestoneId     String?
  initiator       User        @relation("DisputeInitiator", fields: [initiatorId], references: [id])
  initiatorId     String
  resolver        User?       @relation("DisputeResolver", fields: [resolverId], references: [id])
  resolverId      String?
  reason          String
  evidence        String?
  outcome         Dispoutcome @default(PENDING)
  resolvedAt      DateTime?
  createdAt       DateTime    @default(now())

  @@index([escrowId])
  @@index([outcome])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminId     String
  action      String
  entityType  String
  entityId    String
  details     Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model ProtocolConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

model IndexerCursor {
  id              String   @id @default(cuid())
  chainId         Int
  contractAddress String
  lastBlock       Int      @default(0)
  updatedAt       DateTime @updatedAt

  @@unique([chainId, contractAddress])
}

model ChainEvent {
  id              String           @id @default(cuid())
  chainId         Int
  contractAddress String
  txHash          String
  logIndex        Int
  blockNumber     Int
  eventName       String
  escrowOnChainId Int?
  payload         Json
  status          ChainEventStatus @default(CONFIRMED)
  blockHash       String?
  createdAt       DateTime         @default(now())
  escrow          Escrow?          @relation(fields: [escrowId], references: [id])
  escrowId        String?

  @@unique([chainId, contractAddress, txHash, logIndex])
  @@index([chainId, contractAddress, blockNumber])
  @@index([escrowOnChainId])
  @@index([escrowId])
  @@index([status])
}

enum DepositAddressStatus {
  ACTIVE
  REVOKED
}
enum IncomingDepositStatus {
  RECEIVED
  CONFIRMED
  REJECTED
  UNMATCHED
  REORGED
  SWEPT
}
enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
}
model DepositAddress {
  id              String   @id @default(cuid())
  escrow          Escrow   @relation(fields: [escrowId], references: [id], onDelete: Cascade)
  escrowId        String   @unique
  provider        String
  providerRef     String   @unique
  network         String
  asset           String
  address         String
  status          DepositAddressStatus @default(ACTIVE)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deposits        IncomingDeposit[]
  @@unique([network, address])
  @@index([network, asset, status])
}
model IncomingDeposit {
  id                String   @id @default(cuid())
  depositAddress    DepositAddress @relation(fields: [depositAddressId], references: [id], onDelete: Cascade)
  depositAddressId  String
  network           String
  asset             String
  txHash            String
  eventIndex        Int?
  blockNumber       BigInt?
  amountBaseUnits   String
  sender            String
  recipient         String
  confirmations     Int      @default(0)
  status            IncomingDepositStatus @default(RECEIVED)
  rawPayload        Json?
  observedAt        DateTime @default(now())
  confirmedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@unique([network, txHash, eventIndex])
  @@index([depositAddressId, status])
  @@index([network, recipient, status])
}
model WebhookInbox {
  id          String @id @default(cuid())
  provider    String
  eventId     String
  payload     Json
  status      WebhookStatus @default(RECEIVED)
  error       String?
  receivedAt  DateTime @default(now())
  processedAt DateTime?
  @@unique([provider, eventId])
  @@index([status, receivedAt])
}
// ─── CHAT SYSTEM ────────────────────────────────────

enum ChainEventStatus {
  CONFIRMED
  REORGED
}

enum ChatRoomStatus {
  OPEN
  WAITING
  ESCALATED
  CLOSED
}

model ChatRoom {
  id          String         @id @default(cuid())
  user        User           @relation(fields: [userId], references: [id])
  userId      String
  escrow      Escrow?        @relation(fields: [escrowId], references: [id])
  escrowId    String?
  subject     String         @default("Support Request")
  status      ChatRoomStatus @default(OPEN)
  closedAt    DateTime?
  closedBy    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  messages    ChatMessage[]

  @@index([userId])
  @@index([status])
  @@index([escrowId])
}

model ChatMessage {
  id          String   @id @default(cuid())
  room        ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId      String
  sender      User     @relation(fields: [senderId], references: [id])
  senderId    String
  content     String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([roomId, createdAt])
  @@index([senderId])
  @@index([read])
}

// ─── ADMIN TRANSFERS ────────────────────────────────

model AdminTransfer {
  id              String   @id @default(cuid())
  admin           User     @relation(fields: [adminId], references: [id])
  adminId         String
  toAddress       String
  tokenAddress    String
  tokenSymbol     String
  amount          String
  amountDisplay   String
  chainId         Int
  txHash          String   @unique
  blockNumber     Int?
  note            String?
  createdAt       DateTime @default(now())

  @@index([adminId])
  @@index([toAddress])
  @@index([txHash])
  @@index([createdAt])
}
