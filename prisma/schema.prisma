generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ──────────────────────────────────────

enum EscrowState {
  CREATED
  FUNDED
  ACTIVE
  COMPLETED
  DISPUTED
  REFUNDED
  EXPIRED
}

enum EscrowMode {
  LOCKED
  ARBITER
  MULTISIG
}

enum UserRole {
  BUYER
  SELLER
  ADMIN
  ARBITER
}

enum TransactionType {
  FUND
  RELEASE
  REFUND
  DISPUTE_RESOLUTION
  FEE_COLLECTION
  DEPOSIT_WALLET
  WITHDRAWAL
  ADMIN_RELEASE
  INSURANCE_PREMIUM
  REFERRAL_PAYOUT
}

enum FundingMethod {
  WALLET_DIRECT
  DEPOSIT_TRANSFER
  FIAT_STRIPE
}

enum TokenStatus {
  ACTIVE
  BLACKLISTED
  FEATURED
}

enum Dispoutcome {
  PENDING
  BUYER_FAVORED
  SELLER_FAVORED
  SPLIT
}

enum ChainNetwork {
  ETHEREUM
  BNB_CHAIN
  POLYGON
  ARBITRUM
  BASE
  AVALANCHE
  OPTIMISM
  FANTOM
}

enum VerificationTier {
  ANONYMOUS
  VERIFIED
  KYC
}

enum EscrowCategory {
  CRYPTO_TRADE
  FREELANCE
  REAL_ESTATE
  DOMAIN_SALE
  VEHICLE_SALE
  WHOLESALE
  PARTNERSHIP
  INFLUENCER
  CUSTOM
}

enum NotificationType {
  ESCROW_CREATED
  ESCROW_FUNDED
  MILESTONE_DELIVERED
  MILESTONE_APPROVED
  MILESTONE_RELEASED
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  REFUND_PROCESSED
  DEAL_COMPLETED
  DEADLINE_WARNING
  TRUST_SCORE_UPDATE
  REFERRAL_EARNED
  LINK_ACCESSED
}

// ─── MODELS ─────────────────────────────────────

model User {
  id              String           @id @default(cuid())
  walletAddress   String           @unique
  displayName     String?
  email           String?          @unique
  phone           String?
  role            UserRole         @default(BUYER)
  isAdmin         Boolean          @default(false)
  isArbiter       Boolean          @default(false)
  isFrozen        Boolean          @default(false)
  verificationTier VerificationTier @default(ANONYMOUS)
  kycVerifiedAt   DateTime?
  avatarUrl       String?
  bio             String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  buyerEscrows      Escrow[]          @relation("BuyerEscrows")
  sellerEscrows     Escrow[]          @relation("SellerEscrows")
  arbiterEscrows    Escrow[]          @relation("ArbiterEscrows")
  dispuInits        Dispute[]         @relation("DisputeInitiator")
  dispuResolvs      Dispute[]         @relation("DisputeResolver")
  wallets           UserWallet[]
  chatRooms         ChatRoom[]
  chatMessages      ChatMessage[]
  adminTransfers    AdminTransfer[]
  trustScore        TrustScore?
  referralsSent     Referral[]        @relation("ReferralSender")
  referralsReceived Referral[]        @relation("ReferralReceiver")
  notifications     Notification[]
  apiKeys           ApiKey[]
  multiSigApprovals MultiSigApproval[]
  disputeEvidence   DisputeEvidence[]
  templateCreated   EscrowTemplate[]

  @@index([walletAddress])
  @@index([verificationTier])
}

model UserWallet {
  id            String        @id @default(cuid())
  user          User          @relation(fields: [userId], references: [id])
  userId        String
  address       String
  network       ChainNetwork
  label         String?
  isPreferred   Boolean       @default(false)
  isVerified    Boolean       @default(false)
  balance       String?
  lastChecked   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([userId, address, network])
  @@index([userId])
  @@index([network])
}

model Token {
  id              String      @id @default(cuid())
  address         String      @unique
  chainId         Int
  network         ChainNetwork @default(ETHEREUM)
  symbol          String
  name            String
  decimals        Int         @default(18)
  logoUrl         String?
  status          TokenStatus @default(ACTIVE)
  isReflective    Boolean     @default(false)
  hasTax          Boolean     @default(false)
  taxBasisPoints  Int?
  coinGeckoId     String?
  addedBy         String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  escrows         Escrow[]

  @@unique([address, chainId])
  @@index([status])
  @@index([chainId])
}

model Escrow {
  id                      String         @id @default(cuid())
  onChainId               Int            @unique
  chainId                 Int
  network                 ChainNetwork   @default(ETHEREUM)
  title                   String
  description             String?
  category                EscrowCategory @default(CRYPTO_TRADE)
  buyer                   User           @relation("BuyerEscrows", fields: [buyerId], references: [id])
  buyerId                 String
  seller                  User           @relation("SellerEscrows", fields: [sellerId], references: [id])
  sellerId                String
  arbiter                 User?          @relation("ArbiterEscrows", fields: [arbiterId], references: [id])
  arbiterId               String?
  token                   Token          @relation(fields: [tokenId], references: [id])
  tokenId                 String
  totalAmount             String
  fundedAmount            String
  releasedAmount          String         @default("0")
  protocolFeeTotal        String         @default("0")
  state                   EscrowState    @default(CREATED)
  mode                    EscrowMode     @default(LOCKED)
  fundingMethod           FundingMethod?
  agreementHash           String?
  agreementText           String?
  deadline                DateTime?
  fundedAt                DateTime?
  completedAt             DateTime?
  adminApproved           Boolean        @default(false)
  adminApprovedBy         String?
  adminApprovedAt         DateTime?
  adminNotes              String?
  depositWalletAddr       String?
  depositWalletKey        String?
  depositConfirmed        Boolean        @default(false)
  derivationIndex         Int?
  depositNetwork          String?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  // One-Link Escrow
  shareToken              String?        @unique
  isPublicListing         Boolean        @default(false)
  requiresAuth            Boolean        @default(true)

  // Time-Lock
  timeLockUntil           DateTime?
  autoReleaseAt           DateTime?

  // Multi-Sig
  requiredSignatures      Int            @default(1)

  // Insurance
  isInsured               Boolean        @default(false)
  insurancePremium        String?
  insurancePolicyId       String?

  // Template reference
  templateId              String?
  template                EscrowTemplate? @relation(fields: [templateId], references: [id])

  // Referral tracking
  referralCode            String?

  // Vertical-specific metadata
  verticalMetadata        Json?

  milestones              Milestone[]
  transactions            Transaction[]
  dispuInits              Dispute[]      @relation("DisputeEscrow")
  chatRooms               ChatRoom[]
  multiSigApprovals       MultiSigApproval[]

  @@index([state])
  @@index([buyerId])
  @@index([sellerId])
  @@index([chainId])
  @@index([network])
  @@index([shareToken])
  @@index([category])
  @@index([isPublicListing])
}

model Milestone {
  id                    String    @id @default(cuid())
  escrow                Escrow    @relation(fields: [escrowId], references: [id], onDelete: Cascade)
  escrowId              String
  index                 Int
  description           String
  amount                String
  released              Boolean   @default(false)
  dispensed             Boolean   @default(false)
  buyerApproved         Boolean   @default(false)
  sellerDelivered       Boolean   @default(false)
  adminApproved         Boolean   @default(false)
  releasedAt            DateTime?
  deliveryDeadline      DateTime?
  evidenceUrl           String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  dispuInits            Dispute[]

  @@unique([escrowId, index])
  @@index([escrowId])
}

model Transaction {
  id                String          @id @default(cuid())
  escrow            Escrow          @relation(fields: [escrowId], references: [id], onDelete: Cascade)
  escrowId          String
  txHash            String          @unique
  type              TransactionType
  fromAddress       String
  toAddress         String
  amount            String
  feeAmount         String?
  chainId           Int
  blockNumber       Int?
  status            String          @default("CONFIRMED")
  createdAt         DateTime        @default(now())

  @@index([escrowId])
  @@index([txHash])
  @@index([type])
}

model Dispute {
  id              String            @id @default(cuid())
  escrow          Escrow            @relation("DisputeEscrow", fields: [escrowId], references: [id])
  escrowId        String
  milestone       Milestone?        @relation(fields: [milestoneId], references: [id])
  milestoneId     String?
  initiator       User              @relation("DisputeInitiator", fields: [initiatorId], references: [id])
  initiatorId     String
  resolver        User?             @relation("DisputeResolver", fields: [resolverId], references: [id])
  resolverId      String?
  reason          String
  evidence        String?
  outcome         Dispoutcome       @default(PENDING)
  resolvedAt      DateTime?
  coolingEndsAt   DateTime?
  resolutionNotes String?
  buyerSplit      Int?
  sellerSplit     Int?
  createdAt       DateTime          @default(now())

  evidenceFiles   DisputeEvidence[]

  @@index([escrowId])
  @@index([outcome])
}

model DisputeEvidence {
  id          String   @id @default(cuid())
  dispute     Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  disputeId   String
  submitter   User     @relation(fields: [submitterId], references: [id])
  submitterId String
  fileUrl     String
  fileType    String
  description String?
  hash        String?
  createdAt   DateTime @default(now())

  @@index([disputeId])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminId     String
  action      String
  entityType  String
  entityId    String
  details     Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([adminId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model ProtocolConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

// ─── CHAT SYSTEM ────────────────────────────────────

enum ChatRoomStatus {
  OPEN
  WAITING
  ESCALATED
  CLOSED
}

model ChatRoom {
  id          String         @id @default(cuid())
  user        User           @relation(fields: [userId], references: [id])
  userId      String
  escrow      Escrow?        @relation(fields: [escrowId], references: [id])
  escrowId    String?
  subject     String         @default("Support Request")
  status      ChatRoomStatus @default(OPEN)
  closedAt    DateTime?
  closedBy    String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  messages    ChatMessage[]

  @@index([userId])
  @@index([status])
  @@index([escrowId])
}

model ChatMessage {
  id          String   @id @default(cuid())
  room        ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId      String
  sender      User     @relation(fields: [senderId], references: [id])
  senderId    String
  content     String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([roomId, createdAt])
  @@index([senderId])
  @@index([read])
}

// ─── ADMIN TRANSFERS ────────────────────────────────

model AdminTransfer {
  id              String   @id @default(cuid())
  admin           User     @relation(fields: [adminId], references: [id])
  adminId         String
  toAddress       String
  tokenAddress    String
  tokenSymbol     String
  amount          String
  amountDisplay   String
  chainId         Int
  txHash          String   @unique
  blockNumber     Int?
  note            String?
  createdAt       DateTime @default(now())

  @@index([adminId])
  @@index([toAddress])
  @@index([txHash])
  @@index([createdAt])
}

// ─── ESCROW TEMPLATES ───────────────────────────────

model EscrowTemplate {
  id              String         @id @default(cuid())
  name            String
  description     String
  category        EscrowCategory
  creator         User           @relation(fields: [creatorId], references: [id])
  creatorId       String
  isPublic        Boolean        @default(false)
  isOfficial      Boolean        @default(false)
  upvotes         Int            @default(0)
  usageCount      Int            @default(0)
  milestoneTemplates Json
  defaultDeadlineDays Int?
  verticalFields  Json?
  tags            String[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  escrows         Escrow[]

  @@index([category])
  @@index([isPublic])
  @@index([upvotes])
}

// ─── MULTI-SIG APPROVALS ────────────────────────────

model MultiSigApproval {
  id          String   @id @default(cuid())
  escrow      Escrow   @relation(fields: [escrowId], references: [id], onDelete: Cascade)
  escrowId    String
  signer      User     @relation(fields: [signerId], references: [id])
  signerId    String
  action      String
  signature   String?
  approved    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@unique([escrowId, signerId, action])
  @@index([escrowId])
}

// ─── TRUST SCORE & REPUTATION ───────────────────────

model TrustScore {
  id                  String   @id @default(cuid())
  user                User     @relation(fields: [userId], references: [id])
  userId              String   @unique
  score               Int      @default(0)
  totalDealsCompleted Int      @default(0)
  totalVolume         String   @default("0")
  disputeRate         Float    @default(0)
  avgRating           Float    @default(0)
  totalRatings        Int      @default(0)
  onTimeDeliveryRate  Float    @default(0)
  level               String   @default("NEW")
  badgeUrls           String[]
  lastCalculatedAt    DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  ratings             DealRating[]

  @@index([score])
  @@index([level])
}

model DealRating {
  id          String     @id @default(cuid())
  trustScore  TrustScore @relation(fields: [trustScoreId], references: [id])
  trustScoreId String
  escrowId    String
  raterId     String
  rating      Int
  review      String?
  createdAt   DateTime   @default(now())

  @@unique([escrowId, raterId])
  @@index([trustScoreId])
}

// ─── REFERRAL PROGRAM ───────────────────────────────

model Referral {
  id              String   @id @default(cuid())
  sender          User     @relation("ReferralSender", fields: [senderId], references: [id])
  senderId        String
  receiver        User     @relation("ReferralReceiver", fields: [receiverId], references: [id])
  receiverId      String
  referralCode    String
  escrowId        String?
  rewardAmount    String   @default("0")
  rewardPaid      Boolean  @default(false)
  rewardPaidAt    DateTime?
  createdAt       DateTime @default(now())

  @@unique([senderId, receiverId])
  @@index([referralCode])
  @@index([senderId])
}

model ReferralCode {
  id          String   @id @default(cuid())
  userId      String   @unique
  code        String   @unique
  totalUses   Int      @default(0)
  totalEarned String   @default("0")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([code])
}

// ─── NOTIFICATIONS ──────────────────────────────────

model Notification {
  id          String           @id @default(cuid())
  user        User             @relation(fields: [userId], references: [id])
  userId      String
  type        NotificationType
  title       String
  message     String
  data        Json?
  read        Boolean          @default(false)
  emailSent   Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@index([userId, read])
  @@index([type])
  @@index([createdAt])
}

model NotificationPreference {
  id          String   @id @default(cuid())
  userId      String   @unique
  emailEnabled Boolean @default(true)
  pushEnabled  Boolean @default(false)
  dealUpdates  Boolean @default(true)
  disputeAlerts Boolean @default(true)
  referralAlerts Boolean @default(true)
  marketingEmails Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── API KEYS (White-Label / Integration) ───────────

model ApiKey {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  name        String
  keyHash     String   @unique
  keyPrefix   String
  permissions String[]
  rateLimit   Int      @default(1000)
  isActive    Boolean  @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([keyHash])
  @@index([userId])
}

// ─── PUBLIC DEAL FEED ───────────────────────────────

model PublicDeal {
  id              String         @id @default(cuid())
  escrowId        String         @unique
  category        EscrowCategory
  title           String
  amountDisplay   String
  tokenSymbol     String
  network         ChainNetwork
  completedAt     DateTime
  buyerRating     Int?
  sellerRating    Int?
  isAnonymized    Boolean        @default(true)
  buyerDisplay    String?
  sellerDisplay   String?
  createdAt       DateTime       @default(now())

  @@index([category])
  @@index([completedAt])
  @@index([network])
}

// ─── SECURITY EVENTS LOG ────────────────────────────

model SecurityEvent {
  id          String   @id @default(cuid())
  userId      String?
  eventType   String
  severity    String
  ipAddress   String?
  userAgent   String?
  details     Json?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([eventType])
  @@index([severity])
  @@index([createdAt])
}
