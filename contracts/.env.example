# ══════════════════════════════════════════════
#  SURVEYDEAL CONTRACTS — ENVIRONMENT VARIABLES
# For BNB testnet use: npm run deploy:bsc-testnet
# For BNB mainnet use: npm run deploy:bsc-mainnet
# Never commit a real deployer key. Use a deployment secret manager.
# ══════════════════════════════════════════════

# Deployer private key (Hardhat Account #0 for local)
DEPLOYER_PRIVATE_KEY=""

# Admin address (receives DEFAULT_ADMIN_ROLE, ARBITER_ROLE, FEE_MANAGER_ROLE)
ADMIN_ADDRESS=""

# Fee recipient wallet
FEE_RECIPIENT=""

# Fee in basis points (100 = 1%)
FEE_BASIS_POINTS="100"

# Max fee cap in human token units. The BNB USDT token below uses 18 decimals.
MAX_FEE_ABSOLUTE="50"
TOKEN_DECIMALS="18"

# Additional arbiters (comma-separated)
ADDITIONAL_ARBITERS=""

# API keys for verification
ALCHEMY_API_KEY=""
ETHERSCAN_API_KEY=""
ARBISCAN_API_KEY=""
BSCSCAN_API_KEY=""
