# ══════════════════════════════════════════════════════════
#  SURVEYDEAL MULTI-CHAIN ESCROW — ENVIRONMENT VARIABLES
# ══════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/surveydeal?schema=public"

# ── JWT Auth ──────────────────────────────────────────
JWT_SECRET="CHANGE_ME_TO_RANDOM_64_CHAR_HEX_STRING"

# ── Admin Account ─────────────────────────────────────
# Never commit real credentials or private keys. Provision these in the secret manager.
ADMIN_PRIVATE_KEY=""
ADMIN_WALLET=""
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ── Smart Contract ────────────────────────────────────
# ── Encryption ────────────────────────────────────
# 64 hex chars (32 bytes) for AES-256-GCM encryption of deposit wallet private keys
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# ── Multi-Chain RPC URLs ──────────────────────────────
ETH_RPC_URL="https://eth.llamarpc.com"
BSC_RPC_URL="https://bsc-dataseed.binance.org"
POLYGON_RPC_URL="https://polygon-rpc.com"
ARBITRUM_RPC_URL="https://arb1.arbitrum.io/rpc"
BASE_RPC_URL="https://mainnet.base.org"
AVALANCHE_RPC_URL="https://api.avax.network/ext/bc/C/rpc"
OPTIMISM_RPC_URL="https://mainnet.optimism.io"
FANTOM_RPC_URL="https://rpc.ftm.tools"

# ── HD Wallet Generation ──────────────────────────────
# 12-word mnemonic for deterministic deposit wallet generation
GENERATION_MNEMONIC="your twelve word mnemonic phrase goes here replace with your own"

# ── Server ────────────────────────────────────────────
BACKEND_PORT=5000
FRONTEND_URL="http://localhost:3000"
NODE_ENV=development

# ── Blockchain Listener / Event Indexer ─────────────────
# Legacy custodial balance polling is disabled by default.
ENABLE_BLOCKCHAIN_LISTENER=false
ENABLE_LEGACY_DEPOSIT_LISTENER=false
ENABLE_ESCROW_EVENT_INDEXER=true
# Event indexer only starts when a deployed escrow contract is configured.
ESCROW_CONTRACT_ADDRESSES='{"8453":"0xYourVerifiedContractAddress"}'
INDEXER_CHAIN_ID=8453
CONTRACT_ADDRESS=""
INDEXER_MIN_CONFIRMATIONS=3
INDEXER_POLL_INTERVAL_MS=15000
INDEXER_BLOCK_BATCH_SIZE=1000
